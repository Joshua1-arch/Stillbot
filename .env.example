# --- LLM API Key ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Proxy Settings ---
PROXY_SERVER=http://proxy.geonode.com:8000
PROXY_USERNAME=your_username
PROXY_PASSWORD=your_password

# --- Bot Settings ---
DRY_RUN=True
ENABLE_VISION_FALLBACK=True
MAX_RETRIES=3

# Target URL (Defaults to local test server)
TARGET_URL=http://localhost:8080/index.html

# --- Geonix Residential Proxy Pool Credentials ---
GEONIX_HOST=res.geonix.com
PROXY_GENERAL_AUTH=username:password
PROXY_AUSTRALIA_AUTH=username:password
PROXY_NEWYORK_AUTH=username:password
PROXY_FLORIDA_AUTH=username:password
PROXY_ILLINOIS_AUTH=username:password
PROXY_CALIFORNIA_AUTH=username:password
PROXY_UTAH_AUTH=username:password
PROXY_TEXAS_AUTH=username:password
PROXY_PENNSYLVANIA_AUTH=username:password
PROXY_NEWJERSEY_AUTH=username:password
PROXY_MARYLAND_AUTH=username:password
